{
  "name": "express-with-dependencies",
  "version": "0.0.0",
  "scripts": {
    "test:sum": "(node --import tsx src/index.ts & wait-on 'http://localhost:8165' && curl 'http://localhost:8165/sum?a=2&b=4'; kill $(jobs -p))",
    "test:multiply": "(node --import tsx src/index.ts & wait-on 'http://localhost:8165' && curl 'http://localhost:8165/multiply?a=2&b=4'; kill $(jobs -p))",
    "compile": "tsc --noEmit",
    "changeset": "echo 'Please run `pnpm changeset` from the monorepo root'"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@myrepo/api-definition": "workspace:^",
    "@myrepo/multiply": "workspace:^",
    "@myrepo/sum": "workspace:^",
    "@types/express": "^5.0.1",
    "@zodios/core": "^10.9.6",
    "@zodios/express": "^10.6.1",
    "express": "^4.21.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cefn/nextjs-typescript-monorepo.git",
    "directory": "servers/express-with-dependencies"
  },
  "homepage": "https://github.com/cefn/nextjs-typescript-monorepo/tree/main/servers/express-with-dependencies/README.md",
  "bugs": {
    "url": "https://github.com/cefn/nextjs-typescript-monorepo/issues"
  }
}
